# Copy to .env (scripts/setup.sh does this) and fill in at least one LLM API key.
# The values below are the ones the testbed uses; only the keys need to be set.

APP_NAME=Mini Telco Orchestration Platform
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── LLM planner ─────────────────────────────────────────────────────────────
# LLM_PROVIDER must be openai, anthropic or gemini (anything else is rejected).
# The active provider can also be switched at run time: POST /config/provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30
# auto = LLM planner if its key is set, keyword planner otherwise
ORCHESTRATION_DEFAULT_MODE=auto

# ── OpenCAPIF (local, started by start.sh) ──────────────────────────────────
CAPIF_BASE_URL=https://localhost
CAPIF_TOKEN=
CAPIF_VERIFY_SSL=false
CAPIF_TIMEOUT_SECONDS=20
CAPIF_CLIENT_CERT=
CAPIF_CLIENT_KEY=
CAPIF_ONBOARD_PATH=/api-invoker-management/v1/onboardedInvokers
CAPIF_PUBLISH_PATH=/published-apis/v1/apf_id/service-apis
CAPIF_DISCOVER_PATH=/service-apis/v1/allServiceAPIs
CAPIF_ONBOARDING_SECRET=
CAPIF_INVOKER_CERTIFICATE=
CAPIF_REQUEST_TEST_NOTIFICATION=true
CAPIF_USE_DOCKER_NETWORK=false
CAPIF_INTERNAL_BASE_URL=https://nginx
CAPIF_INTERNAL_HOSTNAME=capifcore
REGISTER_BASE_URL=https://localhost:8084
REGISTER_INTERNAL_BASE_URL=https://register:8080
REGISTER_VERIFY_SSL=false
# Default OpenCAPIF admin of the local test deployment
REGISTER_ADMIN_USERNAME=admin
REGISTER_ADMIN_PASSWORD=password123
REGISTER_DEMO_USERNAME=mini_platform_demo
REGISTER_DEMO_PASSWORD=MiniPlatform123!
REGISTER_DEMO_ENTERPRISE=CTTC
REGISTER_DEMO_COUNTRY=ES
REGISTER_DEMO_EMAIL=mini-platform@example.com
REGISTER_DEMO_PURPOSE=CAPIF live onboarding demo

# ── CAMARA / NEF providers (docker-compose.capif.yml overrides these in the container) ──
QOD_PROVIDER_URL=http://host.docker.internal:8002
LOCATION_PROVIDER_URL=http://host.docker.internal:8003
NEF_QOS_PROVIDER_URL=http://host.docker.internal:8585
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_VERIFY_SSL=false
NEF_SCS_AS_ID=1
NEF_NOTIFICATION_URL=http://localhost:8000/notifications
NEF_DEFAULT_UE_IPV4=10.11.11.2
