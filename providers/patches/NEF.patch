diff --git a/MonitoringEventAPI/app/provider_onboarding/publish_openapi_service.py b/MonitoringEventAPI/app/provider_onboarding/publish_openapi_service.py
new file mode 100644
index 0000000..6005afb
--- /dev/null
+++ b/MonitoringEventAPI/app/provider_onboarding/publish_openapi_service.py
@@ -0,0 +1,68 @@
+import argparse
+import os
+from urllib.parse import urlparse
+
+from opencapif_sdk import api_schema_translator, capif_provider_connector
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Publish an arbitrary OpenAPI-described service with an existing CAPIF provider identity."
+    )
+    parser.add_argument(
+        "--config",
+        default="./app/provider_onboarding/provider_config_sample.json",
+        help="Path to the provider CAPIF config JSON.",
+    )
+    parser.add_argument(
+        "--openapi",
+        required=True,
+        help="Path to the OpenAPI YAML/JSON file to translate and publish.",
+    )
+    parser.add_argument(
+        "--api-url",
+        required=True,
+        help="Public URL of the live service endpoint root, e.g. http://host.docker.internal:8003/location-retrieval/v0.5",
+    )
+    parser.add_argument(
+        "--supported-features",
+        default="0",
+        help="CAPIF supportedFeatures value.",
+    )
+    parser.add_argument(
+        "--api-supp-feats",
+        default="0",
+        help="CAPIF apiSuppFeats value.",
+    )
+    return parser.parse_args()
+
+
+def api_name_from_url(api_url: str) -> str:
+    parsed = urlparse(api_url)
+    parts = [part for part in parsed.path.split("/") if part]
+    if len(parts) < 2:
+        raise ValueError(f"API URL must include apiName/apiVersion path segments: {api_url}")
+    return parts[-2]
+
+
+def main() -> None:
+    args = parse_args()
+
+    connector = capif_provider_connector(config_file=args.config)
+    translator = api_schema_translator(args.openapi)
+
+    translator.build(args.api_url, args.supported_features, args.api_supp_feats)
+
+    api_name = api_name_from_url(args.api_url)
+    connector.api_description_path = f"./{api_name}.json"
+
+    connector.publish_req["publisher_apf_id"] = connector.provider_capif_ids["APF-1"]
+    connector.publish_req["publisher_aefs_ids"] = [connector.provider_capif_ids["AEF-1"]]
+    connector.supported_features = args.supported_features
+
+    connector.publish_services()
+    print(f"Published {api_name} from {args.openapi} to CAPIF")
+
+
+if __name__ == "__main__":
+    main()
