+def _resolve_mongo_uri(uri: str) -> str:
+    """Resolve hostnames in Mongo URIs to concrete IPs to avoid Docker DNS/auth quirks."""
+    parsed = urlsplit(uri)
+    hostname = parsed.hostname
+    if not hostname:
+        return uri
+
+    try:
+        resolved_ip = socket.gethostbyname(hostname)
+    except OSError as exc:
+        log.warning("Could not resolve Mongo hostname %s: %s", hostname, exc)
+        return uri
+
+    if resolved_ip == hostname:
+        return uri
+
+    netloc = parsed.netloc
+    if "@" in netloc:
+        creds, hostpart = netloc.rsplit("@", 1)
+        suffix = hostpart[len(hostname):] if hostpart.startswith(hostname) else hostpart.replace(hostname, resolved_ip, 1)
+        new_netloc = f"{creds}@{resolved_ip}{suffix if hostpart.startswith(hostname) else ''}"
+    else:
+        suffix = netloc[len(hostname):] if netloc.startswith(hostname) else netloc.replace(hostname, resolved_ip, 1)
+        new_netloc = f"{resolved_ip}{suffix if netloc.startswith(hostname) else ''}"
+
+    rewritten = urlunsplit((parsed.scheme, new_netloc, parsed.path, parsed.query, parsed.fragment))
+    log.info("Resolved Mongo URI host %s to %s", hostname, resolved_ip)
+    return rewritten
+
