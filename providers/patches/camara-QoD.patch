diff --git a/docker-compose.yaml b/docker-compose.yaml
new file mode 100644
index 0000000..03ce140
--- /dev/null
+++ b/docker-compose.yaml
@@ -0,0 +1,14 @@
+services:
+  camara-qod:
+    build:
+      context: .
+    image: front-research-group/camara-qod:local
+    container_name: camara-qod
+    ports:
+      - "8002:8002"
+    extra_hosts:
+      - "host.docker.internal:host-gateway"
+    environment:
+      ASSESSIONWITHQOS_URL: "http://host.docker.internal:8585/3gpp-as-session-with-qos/v1"
+      LOG_LEVEL: "DEBUG"
+    restart: unless-stopped
